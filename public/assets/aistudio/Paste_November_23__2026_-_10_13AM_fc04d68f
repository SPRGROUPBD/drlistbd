/**
 * 2. COMPACT AUTO SLIDER (132.dp card height, 90x110.dp left image, 4s auto-advance,
 * infinite loop, swipe support, background lifecycle pause/resume, single-slide guard)
 */
@OptIn(ExperimentalFoundationApi::class)
@Composable
private fun CompactMobileAutoSlider(
    slides: List<ResolvedHomeSliderSlide>,
    autoSlideIntervalMs: Long,
    lang: AppLang,
    onSlideVisible: (ResolvedHomeSliderSlide) -> Unit,
    onSlideClick: (ResolvedHomeSliderSlide) -> Unit
) {
    if (slides.isEmpty()) return

    val isSingleSlide = slides.size == 1
    val virtualPageCount = if (isSingleSlide) 1 else Int.MAX_VALUE
    val initialPage = if (isSingleSlide) {
        0
    } else {
        val mid = Int.MAX_VALUE / 2
        mid - (mid % slides.size)
    }

    val pagerState = rememberPagerState(
        initialPage = initialPage,
        pageCount = { virtualPageCount }
    )
    val isDragged by pagerState.interactionSource.collectIsDraggedAsState()

    // Pause autoplay automatically when app enters background (ON_PAUSE / ON_STOP) and resume on ON_RESUME
    var isAppForeground by remember { mutableStateOf(true) }
    val lifecycleOwner = LocalLifecycleOwner.current
    DisposableEffect(lifecycleOwner) {
        val observer = LifecycleEventObserver { _, event ->
            when (event) {
                Lifecycle.Event.ON_RESUME -> isAppForeground = true
                Lifecycle.Event.ON_PAUSE, Lifecycle.Event.ON_STOP -> isAppForeground = false
                else -> Unit
            }
        }
        lifecycleOwner.lifecycle.addObserver(observer)
        onDispose { lifecycleOwner.lifecycle.removeObserver(observer) }
    }

    // Track visible slide analytics
    val currentSlideIndex = if (isSingleSlide) 0 else (pagerState.currentPage % slides.size)
    LaunchedEffect(currentSlideIndex, slides) {
        slides.getOrNull(currentSlideIndex)?.let(onSlideVisible)
    }

    // Autoplay every 4 seconds; pauses during drag or background; disabled if only 1 slide exists
    LaunchedEffect(slides.size, isDragged, isAppForeground, autoSlideIntervalMs) {
        if (!isSingleSlide && !isDragged && isAppForeground) {
            delay(autoSlideIntervalMs.coerceAtLeast(1500L))
            if (!pagerState.isScrollInProgress && isAppForeground) {
                pagerState.animateScrollToPage(
                    page = pagerState.currentPage + 1,
                    animationSpec = tween(durationMillis = 450)
                )
            }
        }
    }

    HorizontalPager(
        state = pagerState,
        userScrollEnabled = !isSingleSlide,
        contentPadding = PaddingValues(horizontal = 14.dp),
        pageSpacing = 10.dp,
        modifier = Modifier
            .fillMaxWidth()
            .testTag("home_compact_auto_slider")
    ) { page ->
        val item = slides[if (isSingleSlide) 0 else page % slides.size]
        val title = tr(lang, item.titleBn, item.titleEn)
        val subtitle = tr(lang, item.subtitleBn, item.subtitleEn)
        val badgeLabel = item.badgeText.ifBlank { tr(lang, "স্পন্সরড", "FEATURED") }
        val ctaLabel = tr(lang, "বিস্তারিত", "View Details")

        Box(
            modifier = Modifier
                .fillMaxWidth()
                .height(132.dp)
                .clip(RoundedCornerShape(16.dp))
                .background(
                    Brush.verticalGradient(
                        colors = listOf(Color(0xFFF2FAFB), Color(0xFFEBF7F8))
                    )
                )
                .border(1.dp, Color(0xFFCBE7EA), RoundedCornerShape(16.dp))
                .clickable { onSlideClick(item) }
                .padding(horizontal = 11.dp, vertical = 10.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxSize(),
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.spacedBy(11.dp)
            ) {
                // Left Side: 90x110.dp Image Frame + Category Badge
                Box(
                    modifier = Modifier
                        .width(90.dp)
                        .height(110.dp)
                        .clip(RoundedCornerShape(12.dp))
                        .background(Color(0xFFE2F1F8))
                        .border(1.dp, Color(0xFFC6E4EA), RoundedCornerShape(12.dp))
                ) {
                    ExternalImageAvatar(
                        imageUrl = item.imageUrl,
                        contentDescription = title,
                        fallbackIcon = Icons.Rounded.MedicalServices,
                        size = 110.dp,
                        shape = RoundedCornerShape(12.dp)
                    )
                    Surface(
                        color = MedicalTeal,
                        shape = RoundedCornerShape(4.dp),
                        modifier = Modifier
                            .align(Alignment.TopStart)
                            .padding(4.dp)
                    ) {
                        Text(
                            text = badgeLabel,
                            style = MaterialTheme.typography.labelSmall.copy(fontSize = 8.5.sp),
                            fontWeight = FontWeight.Bold,
                            color = Color.White,
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis,
                            modifier = Modifier.padding(horizontal = 5.dp, vertical = 1.dp)
                        )
                    }
                }

                // Right Side: Overflow-Protected Info & CTA
                Column(
                    modifier = Modifier
