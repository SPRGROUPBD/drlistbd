@Composable
fun HomeScreen(
    lang: AppLang,
    settings: SiteSettingsEntity,
    adConfig: AdConfigEntity,
    sponsors: List<SponsorEntity> = emptyList(),
    rateCards: List<PlacementRateCardEntity> = PlacementRateCardEngine.defaultRateCards(),
    isOnline: Boolean = true,
    nowMs: Long = System.currentTimeMillis(),
    onSponsorDisplayed: (String, Boolean, String) -> Unit = { _, _, _ -> },
    onSponsorClicked: (String, Boolean) -> Unit = { _, _ -> },
    isSyncing: Boolean,
    specialties: List<SpecialtyEntity>,
    locations: List<LocationEntity>,
    doctors: List<DoctorFullProfile>,
    hospitals: List<HospitalEntity>,
    favoriteIds: Set<String>,
    onRefreshDirectory: () -> Unit,
    onToggleLanguage: () -> Unit = {},
    onOpenNotifications: () -> Unit = {},
    onSearchSubmit: (String) -> Unit,
    onSelectSpecialty: (String) -> Unit,
    onSelectDistrict: (String) -> Unit,
    onToggleFavorite: (String) -> Unit,
    onDoctorClick: (String) -> Unit,
    onNavigateFindDoctors: (availableTodayOnly: Boolean) -> Unit,
    onNavigateFacilitiesTab: (Int) -> Unit,
    onNavigateSavedTab: () -> Unit = {},
    onNavigateAboutTab: () -> Unit = {},
    homeSliderSlides: List<ResolvedHomeSliderSlide> = emptyList(),
    homeSliderAutoSlideMs: Long = 4000L,
    onHomeSliderVisible: (ResolvedHomeSliderSlide) -> Unit = {},
    onHomeSliderClick: (ResolvedHomeSliderSlide) -> Unit = {},
    modifier: Modifier = Modifier
) {
    // null = All 64 districts; otherwise selected division nameEn from SeedData.bangladeshDivisions
    var selectedDivisionEn by remember { mutableStateOf<String?>(null) }
    // Collapsible state for "বিভাগ অনুযায়ী ৬৪টি জেলা" dropdown bar to save vertical space
    var isDistrictDropdownExpanded by remember { mutableStateOf(false) }

    // Top App Bar inline search & manual AutoSync burst state (stops automatically once sync completes)
    var isSearchExpanded by remember { mutableStateOf(false) }
    var searchQuery by remember { mutableStateOf("") }
    var manualSyncPulse by remember { mutableStateOf(false) }

    LaunchedEffect(manualSyncPulse, isSyncing) {
        if (manualSyncPulse) {
            delay(900L)
            if (!isSyncing) {
                manualSyncPulse = false
            }
        }
    }
    val effectiveSyncing = isSyncing || manualSyncPulse

    val displayedDistricts = remember(selectedDivisionEn) {
        if (selectedDivisionEn == null) {
            SeedData.allDistricts
        } else {
            SeedData.bangladeshDivisions
                .firstOrNull { it.nameEn == selectedDivisionEn }
                ?.districts ?: SeedData.allDistricts
        }
    }

    val filteredSlides = remember(homeSliderSlides, searchQuery) {
        val q = searchQuery.trim()
        if (q.isEmpty()) homeSliderSlides
        else homeSliderSlides.filter { slide ->
            slide.titleBn.contains(q, ignoreCase = true) ||
                slide.titleEn.contains(q, ignoreCase = true) ||
                slide.subtitleBn.contains(q, ignoreCase = true) ||
                slide.subtitleEn.contains(q, ignoreCase = true) ||
                slide.badgeText.contains(q, ignoreCase = true)
        }
    }

    val availableTodayDocs = remember(doctors) { doctors.filter { it.isAvailableToday() }.take(5) }
    val recentDocs = remember(doctors) { doctors.sortedByDescending { it.doctor.updatedAt }.take(6) }

    Scaffold(
        modifier = modifier.fillMaxSize(),
        containerColor = BackgroundIce,
        topBar = {
            DoctorListTopBar(
                lang = lang,
                isSyncing = effectiveSyncing,
                isSearchExpanded = isSearchExpanded,
                searchQuery = searchQuery,
                onToggleSearch = {
                    isSearchExpanded = !isSearchExpanded
                    if (!isSearchExpanded && searchQuery.isNotEmpty()) {
                        searchQuery = ""
                    }
                },
                onSearchQueryChange = { searchQuery = it },
                onSearchSubmit = {
                    if (searchQuery.isNotBlank()) onSearchSubmit(searchQuery.trim())
                },
                onToggleLanguage = onToggleLanguage,
                onTriggerAutoSync = {
                    if (!effectiveSyncing) {
                        manualSyncPulse = true
                        onRefreshDirectory()
                    }
                },
                onOpenNotifications = onOpenNotifications
            )
        },
        bottomBar = {
            DoctorListBottomNavBar(
                lang = lang,
                onNavigateHome = { /* Already on Home */ },
                onNavigateDoctors = { onNavigateFindDoctors(false) },
                onNavigateHospitals = { onNavigateFacilitiesTab(0) },
                onNavigateSaved = onNavigateSavedTab,
                onNavigateAbout = onNavigateAboutTab
            )
        }
    ) { innerPadding ->
        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
                .background(BackgroundIce),
            contentPadding = PaddingValues(top = 10.dp, bottom = 18.dp)
        ) {
            // 1. COMPACT AUTO SLIDER (Placed Directly Beneath the Top App Bar: 132.dp height, 90x110.dp image)
            if (filteredSlides.isNotEmpty()) {
                item(key = "home_top_slider_carousel") {
                    CompactMobileAutoSlider(
                        slides = filteredSlides,
                        autoSlideIntervalMs = homeSliderAutoSlideMs,
                        lang = lang,
                        onSlideVisible = onHomeSliderVisible,
                        onSlideClick = onHomeSliderClick
                    )
                    Spacer(Modifier.height(10.dp))
                }
            }

            // 2. Quick-Filter Pills Row
            item {
                LazyRow(
                    contentPadding = PaddingValues(horizontal = 16.dp),
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    item {
                        QuickNavChip(
                            icon = Icons.Rounded.EventAvailable,
                            label = AppStrings.availableToday(lang),
                            tint = EmeraldAvailable,
                            onClick = { onNavigateFindDoctors(true) }
                        )
                    }
                    item {
                        QuickNavChip(
                            icon = Icons.Rounded.Schedule,
                            label = AppStrings.chamberSchedule(lang),
                            tint = MedicalBlue,
                            onClick = { onNavigateFacilitiesTab(3) }
                        )
                    }
                    item {
                        QuickNavChip(
                            icon = Icons.Rounded.LocalHospital,
                            label = AppStrings.hospitals(lang),
                            tint = MedicalTeal,
                            onClick = { onNavigateFacilitiesTab(0) }
                        )
                    }
                    item {
                        QuickNavChip(
                            icon = Icons.Rounded.Biotech,
                            label = AppStrings.diagnosticCenters(lang),
                            tint = MedicalBlueDark,
                            onClick = { onNavigateFacilitiesTab(1) }
                        )
                    }
                    item {
                        QuickNavChip(
                            icon = Icons.Rounded.Campaign,
                            label = tr(lang, "বিজ্ঞপ্তি", "Notices"),
                            tint = Color(0xFFF59E0B),
                            onClick = onOpenNotifications
                        )
                    }
                }
                Spacer(Modifier.height(8.dp))
            }

            // HOME-02: Single Section Native Slot
            item {
                val hasHome02 = remember(sponsors, rateCards, nowMs / 60_000L) {
                    adConfig.adsEnabled && PlacementRateCardEngine.selectSponsorForPlacement(
                        sponsors = sponsors,
                        rateCards = rateCards,
                        placementId = PlacementRateCardEngine.HOME_02,
                        nowMs = nowMs
                    ) != null
                }
                if (hasHome02) {
                    PlacementSponsorSlot(
                        placementId = PlacementRateCardEngine.HOME_02,
                        sponsors = sponsors,
                        rateCards = rateCards,
                        adConfig = adConfig,
                        isOnline = isOnline,
                        nowMs = nowMs,
                        lang = lang,
                        onSponsorDisplayed = onSponsorDisplayed,
                        onSponsorClicked = onSponsorClicked,
                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 2.dp)
                    )
                } else {
                    NativeSponsorAdCard(
                        sponsors = sponsors,
                        adConfig = adConfig,
                        pageKey = SponsorCampaignSelector.PAGE_HOME,
                        slotIndex = 0,
                        isOnline = isOnline,
                        nowMs = nowMs,
                        lang = lang,
                        onSponsorDisplayed = onSponsorDisplayed,
                        onSponsorClicked = onSponsorClicked,
                        enforce300x200 = true,
                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 2.dp)
                    )
                }
                Spacer(Modifier.height(6.dp))
            }

            // 3. চিকিৎসা বিশেষজ্ঞতা (Ultra-Compact Medical Specialties Strip) + HOME-06
            item {
                CompactSectionHeader(
                    title = AppStrings.specialties(lang),
                    actionLabel = AppStrings.allLabel(lang),
                    onAction = { onNavigateFacilitiesTab(2) }
                )
                Spacer(Modifier.height(4.dp))
                CompactSpecialtyStrip(
                    specialties = specialties,
                    lang = lang,
                    onSelect = { id -> onSelectSpecialty(id) }
                )
                PlacementSponsorSlot(
                    placementId = PlacementRateCardEngine.HOME_06,
                    sponsors = sponsors,
                    rateCards = rateCards,
                    adConfig = adConfig,
                    isOnline = isOnline,
                    nowMs = nowMs,
                    lang = lang,
                    onSponsorDisplayed = onSponsorDisplayed,
                    onSponsorClicked = onSponsorClicked,
                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp)
                )
                Spacer(Modifier.height(8.dp))
            }

            // 4. বিভাগ অনুযায়ী ৬৪টি জেলা (Space-Saving Collapsible Single-Row Dropdown Bar)
            item(key = "home_64_districts_dropdown") {
                Surface(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(horizontal = 16.dp),
                    shape = RoundedCornerShape(14.dp),
                    color = SurfaceWhite,
                    border = BorderStroke(1.dp, OutlineSoft)
                ) {
                    Column(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(horizontal = 12.dp, vertical = 8.dp)
                    ) {
                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .clickable { isDistrictDropdownExpanded = !isDistrictDropdownExpanded }
                                .testTag("home_district_dropdown_toggle"),
                            horizontalArrangement = Arrangement.SpaceBetween,
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            Row(
                                verticalAlignment = Alignment.CenterVertically,
                                modifier = Modifier.weight(1f)
                            ) {
                                Icon(
                                    imageVector = Icons.Outlined.LocationOn,
                                    contentDescription = null,
                                    tint = MedicalTeal,
                                    modifier = Modifier.size(16.dp)
                                )
                                Spacer(Modifier.width(6.dp))
                                Text(
                                    text = tr(lang, "বিভাগ অনুযায়ী ৬৪টি জেলা", "64 Districts by Division"),
                                    style = MaterialTheme.typography.titleSmall,
                                    fontWeight = FontWeight.Bold,
                                    color = TextPrimary,
                                    maxLines = 1,
                                    overflow = TextOverflow.Ellipsis
                                )
                            }

                            Row(
                                verticalAlignment = Alignment.CenterVertically,
                                horizontalArrangement = Arrangement.spacedBy(6.dp)
                            ) {
                                StatusPill(
                                    text = tr(lang, "৮ বিভাগ • ৬৪ জেলা", "8 Div • 64 Dist"),
                                    bgColor = MedicalTealLight,
                                    textColor = MedicalTealDark
                                )
                                Box(
                                    modifier = Modifier
                                        .size(24.dp)
                                        .clip(CircleShape)
                                        .background(BackgroundIce),
                                    contentAlignment = Alignment.Center
                                ) {
                                    Icon(
                                        imageVector = if (isDistrictDropdownExpanded) {
                                            Icons.Rounded.KeyboardArrowUp
                                        } else {
                                            Icons.Rounded.KeyboardArrowDown
                                        },
                                        contentDescription = tr(lang, "জেলা তালিকা দেখুন", "Toggle Districts"),
                                        tint = MedicalBlue,
                                        modifier = Modifier.size(18.dp)
                                    )
                                }
                            }
                        }

                        AnimatedVisibility(
                            visible = isDistrictDropdownExpanded,
                            enter = expandVertically(),
                            exit = shrinkVertically()
                        ) {
                            Column(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .padding(top = 8.dp)
                            ) {
                                HorizontalDivider(color = OutlineSoft, thickness = 0.8.dp)
                                Spacer(Modifier.height(6.dp))

                                LazyRow(
                                    horizontalArrangement = Arrangement.spacedBy(6.dp),
                                    modifier = Modifier.testTag("home_division_row")
                                ) {
                                    item {
                                        FilterChip(
                                            selected = selectedDivisionEn == null,
                                            onClick = { selectedDivisionEn = null },
                                            modifier = Modifier.height(30.dp),
                                            label = {
                                                Text(
                                                    text = tr(lang, "সব বিভাগ (৬৪)", "All (64)"),
                                                    style = MaterialTheme.typography.labelSmall
                                                )
                                            },
                                            colors = FilterChipDefaults.filterChipColors(
                                                selectedContainerColor = MedicalBlue,
                                                selectedLabelColor = Color.White,
                                                containerColor = BackgroundIce
                                            )
                                        )
                                    }
                                    items(SeedData.bangladeshDivisions, key = { it.nameEn }) { div ->
                                        val shortDivLabel = tr(
                                            lang,
                                            "${div.nameBn.removeSuffix(" বিভাগ")} (${div.districts.size})",
                                            "${div.nameEn} (${div.districts.size})"
                                        )
                                        FilterChip(
                                            selected = selectedDivisionEn == div.nameEn,
                                            onClick = {
                                                selectedDivisionEn =
                                                    if (selectedDivisionEn == div.nameEn) null else div.nameEn
                                            },
                                            modifier = Modifier.height(30.dp),
                                            label = {
                                                Text(
                                                    text = shortDivLabel,
                                                    style = MaterialTheme.typography.labelSmall
                                                )
                                            },
                                            colors = FilterChipDefaults.filterChipColors(
                                                selectedContainerColor = MedicalBlue,
                                                selectedLabelColor = Color.White,
                                                containerColor = BackgroundIce
                                            )
                                        )
                                    }
                                }

                                Spacer(Modifier.height(6.dp))

                                LazyRow(
                                    horizontalArrangement = Arrangement.spacedBy(6.dp),
                                    modifier = Modifier.testTag("home_district_row")
                                ) {
                                    items(
                                        displayedDistricts,
                                        key = { "${it.divisionEn}_${it.nameEn}" }
                                    ) { dist ->
                                        FilterChip(
                                            selected = false,
                                            onClick = {
                                                isDistrictDropdownExpanded = false
                                                onSelectDistrict(dist.nameEn)
                                            },
                                            modifier = Modifier.height(30.dp),
                                            label = {
                                                Text(
                                                    text = tr(lang, dist.nameBn, dist.nameEn),
                                                    style = MaterialTheme.typography.labelSmall
                                                )
                                            },
                                            leadingIcon = {
                                                Icon(
                                                    Icons.Outlined.LocationOn,
                                                    contentDescription = null,
                                                    tint = MedicalTeal,
                                                    modifier = Modifier.size(13.dp)
                                                )
                                            },
                                            colors = FilterChipDefaults.filterChipColors(
                                                containerColor = SurfaceWhite
                                            )
                                        )
                                    }
                                }
                            }
                        }
                    }
                }
                Spacer(Modifier.height(10.dp))
            }

            if (isOnline) {
                item {
                    ManagedNativeBannerAd(
                        adConfig = adConfig,
                        isOnline = isOnline,
                        refreshKey = "home_mid",
                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp)
                    )
                }
            }

            if (doctors.isEmpty()) {
                item {
                    EmptyStateCard(
                        icon = Icons.Outlined.MedicalServices,
                        title = tr(lang, "এখনো কোনো ডাক্তার যুক্ত করা হয়নি", "No Doctors Listed Yet"),
                        subtitle = tr(
                            lang,
                            "অ্যাডমিন প্যানেল থেকে ডাক্তার ও চেম্বার যুক্ত করার সাথে সাথে এখানে প্রদর্শিত হবে।",
                            "Doctors and chamber schedules published by the administrator will appear here automatically."
                        ),
                        actionText = tr(lang, "তথ্য রিফ্রেশ করুন", "Refresh Directory"),
                        onAction = {
                            manualSyncPulse = true
                            onRefreshDirectory()
                        }
                    )
                }
            } else {
                // OTH-FEATURED: Featured Section + Available Today
                item {
                    PlacementSponsorSlot(
                        placementId = PlacementRateCardEngine.OTH_FEATURED,
                        sponsors = sponsors,
                        rateCards = rateCards,
                        adConfig = adConfig,
                        isOnline = isOnline,
                        nowMs = nowMs,
                        lang = lang,
                        onSponsorDisplayed = onSponsorDisplayed,
                        onSponsorClicked = onSponsorClicked,
                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp)
                    )
                }
                if (availableTodayDocs.isNotEmpty()) {
                    item {
                        SectionHeader(
                            title = AppStrings.availableToday(lang),
                            actionLabel = AppStrings.allLabel(lang),
                            onAction = { onNavigateFindDoctors(true) }
                        )
                    }
                    itemsIndexed(availableTodayDocs, key = { _, it -> "today_${it.doctor.id}" }) { index, doc ->
                        DoctorCard(
                            item = doc,
                            lang = lang,
                            isFavorite = doc.doctor.id in favoriteIds,
                            onToggleFavorite = { onToggleFavorite(doc.doctor.id) },
                            onClick = { onDoctorClick(doc.doctor.id) },
                            modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp)
                        )
                        if (SponsorCampaignSelector.shouldInsertNativeAfterDoctorCard(index)) {
                            val slot = 1 + SponsorCampaignSelector.nativeSlotIndexForDoctorCard(index)
                            val hasDirectNative = remember(sponsors, adConfig, slot, nowMs / 60_000L) {
                                adConfig.adsEnabled && adConfig.nativeSponsorEnabled &&
                                    SponsorCampaignSelector.selectNativeSponsorForSlot(
                                        sponsors = sponsors,
                                        pageKey = SponsorCampaignSelector.PAGE_HOME,
                                        slotIndex = slot,
                                        nowMs = nowMs
                                    ) != null
                            }
                            if (hasDirectNative) {
                                NativeSponsorAdCard(
                                    sponsors = sponsors,
                                    adConfig = adConfig,
                                    pageKey = SponsorCampaignSelector.PAGE_HOME,
                                    slotIndex = slot,
                                    isOnline = isOnline,
                                    nowMs = nowMs,
                                    lang = lang,
                                    onSponsorDisplayed = onSponsorDisplayed,
                                    onSponsorClicked = onSponsorClicked,
                                    enforce300x200 = true,
                                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp)
                                )
                            } else if (isOnline && adConfig.adsEnabled && adConfig.nativeBannerEnabled) {
                                ManagedNativeBannerAd(
                                    adConfig = adConfig,
                                    isOnline = isOnline,
                                    refreshKey = "home_today_native_$slot",
                                    enforce300x200 = true,
                                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp)
                                )
                            }
                        }
                    }
                }

                // Directory Doctors List + HOME-03: Popular Doctor Section Placement
                item {
                    Spacer(Modifier.height(6.dp))
                    SectionHeader(
                        title = tr(lang, "বিশেষজ্ঞ ডাক্তারবৃন্দ", "Specialist Doctors"),
                        actionLabel = AppStrings.allLabel(lang),
                        onAction = { onNavigateFindDoctors(false) }
                    )
                    PlacementSponsorSlot(
                        placementId = PlacementRateCardEngine.HOME_03,
                        sponsors = sponsors,
                        rateCards = rateCards,
                        adConfig = adConfig,
                        isOnline = isOnline,
                        nowMs = nowMs,
                        lang = lang,
                        onSponsorDisplayed = onSponsorDisplayed,
                        onSponsorClicked = onSponsorClicked,
                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp)
                    )
                }
                val featuredSlice = doctors.take(10)
                itemsIndexed(featuredSlice, key = { _, it -> "dir_${it.doctor.id}" }) { index, doc ->
                    DoctorCard(
                        item = doc,
                        lang = lang,
                        isFavorite = doc.doctor.id in favoriteIds,
                        onToggleFavorite = { onToggleFavorite(doc.doctor.id) },
                        onClick = { onDoctorClick(doc.doctor.id) },
                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp)
                    )
                    if (SponsorCampaignSelector.shouldInsertNativeAfterDoctorCard(index)) {
                        val slot = 3 + SponsorCampaignSelector.nativeSlotIndexForDoctorCard(index)
                        val hasDirectNative = remember(sponsors, adConfig, slot, nowMs / 60_000L) {
                            adConfig.adsEnabled && adConfig.nativeSponsorEnabled &&
                                SponsorCampaignSelector.selectNativeSponsorForSlot(
                                    sponsors = sponsors,
                                    pageKey = SponsorCampaignSelector.PAGE_HOME,
                                    slotIndex = slot,
                                    nowMs = nowMs
                                ) != null
                        }
                        if (hasDirectNative) {
                            NativeSponsorAdCard(
                                sponsors = sponsors,
                                adConfig = adConfig,
                                pageKey = SponsorCampaignSelector.PAGE_HOME,
                                slotIndex = slot,
                                isOnline = isOnline,
                                nowMs = nowMs,
                                lang = lang,
                                onSponsorDisplayed = onSponsorDisplayed,
                                onSponsorClicked = onSponsorClicked,
                                enforce300x200 = true,
                                modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp)
                            )
                        } else if (isOnline && adConfig.adsEnabled && adConfig.nativeBannerEnabled) {
                            ManagedNativeBannerAd(
                                adConfig = adConfig,
                                isOnline = isOnline,
                                refreshKey = "home_dir_native_$slot",
                                enforce300x200 = true,
                                modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp)
                            )
                        }
                    }
                }

                // Recently Updated Doctors
